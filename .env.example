# LearnGenie AI Environment Variables Template
# Copy this file to `.env` and fill in the values below.

# PostgreSQL Connection URL
# Example: postgresql://postgres:postgres@localhost:5432/learngenie
DATABASE_URL="your-postgresql-connection-string"

# Google Gemini API Key
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# Port for the Express backend server (default: 8080)
PORT=8080
